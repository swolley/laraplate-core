{
  "name": "swolley/laraplate-core",
  "vendor": "swolley",
  "description": "Core Module contains all the necessary functionalities for build up a new Laravel application.",
  "version": "v1.76.0",
  "keywords": [
    "laravel",
    "laraplate",
    "core"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "laravel-module",
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/swolley/license-compliance-checker.git",
      "no-api": true
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-redis": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-intl": "*",
    "ext-sockets": "*",
    "doctrine/dbal": "*",
    "laravel/framework": "^12.0",
    "laravel/fortify": "^1.25",
    "hedii/laravel-gelf-logger": "^10.0",
    "lab404/laravel-impersonate": "^1.7",
    "overtrue/laravel-versionable": "^5.4",
    "spatie/laravel-permission": "^6.16",
    "staudenmeir/laravel-adjacency-list": "^1.24",
    "laravel/socialite": "^5.18",
    "stephenlake/laravel-approval": "^1.1",
    "wotz/laravel-swagger-ui": "^1.2",
    "elasticsearch/elasticsearch": "^8.17",
    "laravel/horizon": "^5.31",
    "babenkoivan/elastic-scout-driver": "^4.0",
    "typesense/typesense-php": "^5.0",
    "laravel/scout": "^10.14",
    "matanyadaev/laravel-eloquent-spatial": "^4.5",
    "babenkoivan/elastic-scout-driver-plus": "^5.1",
    "spatie/eloquent-sortable": "^4.4",
    "spatie/laravel-medialibrary": "^11.12",
    "livewire/livewire": "^4.0",
    "filament/spatie-laravel-media-library-plugin": "^5.1",
    "spatie/fork": "^1.2",
    "yajra/laravel-oci8": "^12.0"
  },
  "scripts": {
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [],
      "aliases": {},
      "dont-discover": [
        "yajra/laravel-oci8"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\Core\\": "app/",
      "Modules\\Core\\Database\\Factories\\": "database/factories/",
      "Modules\\Core\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Core\\Tests\\": "tests/"
    },
    "classmap": [
      "stubs/App/"
    ]
  },
  "config": {
    "platform": {
      "ext-oci8": "3.0.1"
    },
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "wikimedia/composer-merge-plugin": true
    }
  }
}
